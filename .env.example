# ===== Club Campestre - configuración de ejemplo (SIN SECRETOS) =====
# Copie este archivo como .env y capture sus valores reales. Nunca suba .env al repositorio.

# Conexión a PostgreSQL (use sslmode=require en producción)
DATABASE_URL=postgres://usuario:contraseña@host:5432/club_campestre?sslmode=require

# URL pública del sistema (se usa para enlaces de recuperación y validación de origen)
APP_URL=https://ventas.su-dominio.mx

# Clave aleatoria de 32+ caracteres para firmar tokens (genere con: openssl rand -hex 32)
SESSION_SECRET=

# Almacenamiento de documentos: "local" (carpeta privada del servidor) o "s3" (S3, Cloudflare R2, etc.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Correo para recuperación de contraseña (opcional; si no se configura, el administrador genera el enlace)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Club Campestre <no-responder@su-dominio.mx>"

# Use "true" sólo en desarrollo local sin HTTPS
ALLOW_INSECURE_COOKIES=false
